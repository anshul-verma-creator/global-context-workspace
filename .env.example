NODE_ENV=development

# Server
SERVER_PORT=3000
SERVER_HOST=localhost

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=context_workspace
POSTGRES_USER=context_user
POSTGRES_PASSWORD=context_password
POSTGRES_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Runtime
RUNTIME_DATA_DIR=~/.context-runtime
RUNTIME_SERVER_URL=ws://localhost:3000

# Auth
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRY=1h
DEVICE_TOKEN_EXPIRY=30d

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
