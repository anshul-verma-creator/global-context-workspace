{
  "name": "@context-workspace/server",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Context Server — REST API + WebSocket + Redis realtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@context-workspace/shared": "workspace:*",
    "@context-workspace/protocol": "workspace:*",
    "@context-workspace/database": "workspace:*",
    "@context-workspace/events": "workspace:*",
    "@context-workspace/security": "workspace:*",
    "@context-workspace/retrieval": "workspace:*",
    "@context-workspace/context-compiler": "workspace:*",
    "@context-workspace/steno": "workspace:*",
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@fastify/sensible": "^6.0.0",
    "postgres": "^3.4.0",
    "ioredis": "^5.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
