{
  "name": "context-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Global Context Workspace — multi-agent AI coordination system",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "format": "prettier --write \"**/*.{ts,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,json,md}\" --ignore-path .prettierignore",
    "dev:server": "pnpm --filter @context-workspace/server dev",
    "dev:runtime": "pnpm --filter @context-workspace/runtime dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
