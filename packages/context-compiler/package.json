{
  "name": "@context-workspace/context-compiler",
  "version": "0.1.0",
  "private": true,
  "description": "Context compiler — minimum sufficient context for AI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@context-workspace/shared": "workspace:*",
    "@context-workspace/protocol": "workspace:*",
    "@context-workspace/database": "workspace:*",
    "@context-workspace/retrieval": "workspace:*",
    "@context-workspace/steno": "workspace:*"
  },
  "devDependencies": { "typescript": "^5.5.0", "vitest": "^2.0.0" }
}
